# Copy to .env (gitignored). Used by Flutter via --dart-define or flutter_dotenv.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# FCM (device) — still uses google-services.json / Firebase Messaging SDK on Android.
